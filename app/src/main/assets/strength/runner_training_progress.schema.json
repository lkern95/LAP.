{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lap.local/schemas/runner_training_progress_v2.schema.json",
  "title": "LAP Krafttraining – Status einer Durchführung",
  "description": "Jede Durchführung besitzt eine stabile Session-ID und enthält den unveränderlichen Inhaltsstand des verwendeten Übungskatalogs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "workoutId",
    "catalogSnapshot",
    "status",
    "currentExerciseId",
    "currentRound",
    "completedSets",
    "isCurrentSetStarted",
    "pauseUntilMillis",
    "startedAtMillis",
    "finishedAtMillis"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "sessionId": { "type": "string", "format": "uuid" },
    "workoutId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "catalogSnapshot": { "$ref": "runner_training_catalog_v2.schema.json" },
    "status": { "enum": ["in_progress", "completed"] },
    "currentExerciseId": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
    "currentRound": { "type": "integer", "minimum": 1 },
    "completedSets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exerciseId", "round", "completedAtMillis"],
        "properties": {
          "exerciseId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "round": { "type": "integer", "minimum": 1 },
          "completedAtMillis": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "isCurrentSetStarted": { "type": "boolean" },
    "pauseUntilMillis": { "type": ["integer", "null"], "minimum": 0 },
    "startedAtMillis": { "type": "integer", "minimum": 0 },
    "finishedAtMillis": { "type": ["integer", "null"], "minimum": 0 }
  }
}
